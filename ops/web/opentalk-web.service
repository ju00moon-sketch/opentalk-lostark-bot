[Unit]
Description=OpenTalk web authentication
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=opentalk-web
Group=opentalk-web
WorkingDirectory=/opt/opentalk-web/current
EnvironmentFile=/etc/opentalk-web.env
ExecStart=/usr/bin/node /opt/opentalk-web/current/src/start.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StateDirectory=opentalk-web
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opentalk-web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RemoveIPC=true
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
